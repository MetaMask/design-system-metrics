{
  "projects": {
    "extension": {
      "rootFolder": "repos/metamask-extension/ui",
      "legacyComponentFolder": "repos/metamask-extension/ui/components/component-library",
      "ignoreFolders": [
        "repos/metamask-extension/ui/components/component-library"
      ],
      "filePattern": "repos/metamask-extension/ui/**/*.{js,tsx}",
      "outputFile": "metrics/extension-component-metrics.xlsx",
      "currentPackages": [
        "@metamask/design-system-react"
      ]
    },
    "mobile": {
      "rootFolder": "repos/metamask-mobile/app",
      "legacyComponentFolder": "repos/metamask-mobile/app/component-library",
      "ignoreFolders": [
        "repos/metamask-mobile/app/component-library"
      ],
      "filePattern": "repos/metamask-mobile/app/components/**/*.{js,jsx,ts,tsx}",
      "outputFile": "metrics/mobile-component-metrics.xlsx",
      "codeOwnerMetricIgnoreGlobs": [
        "app/components/**/Ramp/Deposit/**",
        "app/components/**/Ramp/Aggregator/**"
      ],
      "currentPackages": [
        "@metamask/design-system-react-native"
      ]
    }
  }
}
